// Gram settings
//
// For information on how to configure Gram, see the Gram
// documentation: gram://docs/configuring-gram
//
// To see all of Gram's default settings without changing your
// custom settings, run `gram: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "node": {
    "allow_npm_install": true,
    "allow_binary_download": true
  },
  "lsp": {
    "json-language-server": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "lemminx": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "rust-analyzer": {
      "binary": {
        "ignore_system_version": false,
        "enable_auto_updates": true,
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    }
  },
  "enable_language_server": true,
  "icon_theme": "Gram (Default)",
  "vim_mode": true,
  "base_keymap": "JetBrains",
  "theme": {
    "mode": "dark",
    "light": "Melange Light",
    "dark": "Ayu Dark",
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_branch_name": false,
    "show_menus": false,
    "show_user_picture": false,
    "show_branch_icon": false,
  },
  "tab_bar": {
    "show": false,
  },
  "toolbar": {
    "quick_actions": false,
  },
  "status_bar": {
    "show": false
  },
  "project_panel": {
    "dock": "right",
    "file_icons": true,
    "folder_icons": true,
    "default_width": 400,
    "hide_root": true,
    "auto_fold_dirs": false,
    "starts_open": false,
    "git_status": false,
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never",
    },
    "indent_guides": {
      "show": "always",
    },
  },
  "outline_panel": {
     "dock": "right",
    "folder_icons": true,
    "file_icons": true,
    "default_width": 300,
    "indent_guides": {
      "show": "never",
    },
  },
  "file_finder": {
    "modal_max_width": "medium",
  },
  "scrollbar": {
    "show": "never",
  },
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
    "runnables": false,
  },
  "indent_guides": {
    "enabled": true,
  },
  "colorize_brackets": true,
  "ui_font_family": "Iosevka Nerd Font Mono",
  "ui_font_size": 14,
  "buffer_font_family": "Iosevka Nerd Font Mono",
  "buffer_font_size": 14,
  "buffer_line_height": {
    "custom": 2,
  },
  "multi_cursor_modifier": "cmd_or_ctrl",
  "cursor_shape": "bar",
  "cursor_blink": true,
  "selection_highlight": false,
  "drag_and_drop_selection": {
    "enabled": false,
  },
  "seed_search_query_from_cursor": "never",
  "current_line_highlight": "none",
  "relative_line_numbers": "enabled",
  "show_whitespaces": "none",
  "tab_size": 4,
  "auto_indent": true,
  "auto_indent_on_paste": true,
  "show_completions_on_input": true,
  "show_completion_documentation": true,
  "inline_code_actions": false,
  "lsp_document_colors": "none",
  "hover_popover_enabled": true,
  "format_on_save": "on",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "extend_comment_on_newline": false,
  "horizontal_scroll_margin": 1,
  "vertical_scroll_margin": 1,
  "when_closing_with_no_tabs": "keep_window_open",
  "close_on_file_delete": true,
  "restore_on_file_reopen": false,
  "restore_on_startup": "empty_tab",
  "session": {
    "restore_unsaved_buffers": false,
  },
  "terminal": {
      "font_family": "Iosevka Nerd Font Mono",
  }
}
